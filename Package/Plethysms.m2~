			    else if not member(7,P#"parabolic") then l = entries t ^{2,1,3,4,5}
			    else l = entries t ^{1,2,3,4,5,6};
			    )
			else (
			    if not member(6,P#"parabolic") then (
				l =  entries t ^{1,2,3,4};
