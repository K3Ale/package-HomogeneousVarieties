				)
			    else if not member(7,P#"parabolic") then (
				l = entries t ^{5,1,2,3,4,0};
				if member(8,P#"parabolic") then l = l | entries t^{7};
				)
			    else (
				l = entries t^{0,1,2,3,4,5,6,7};
				);
			    );
			);
		    );
		);
	    );
	);
