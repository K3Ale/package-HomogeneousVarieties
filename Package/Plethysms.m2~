	    T#l' = Ttemp#t; -- ho lasciato solo questo perchè secondo me non può succedere che ci siano ripetizioni nel caso irriducibile
	    );
	T = new HashTable from T;
	E' := homogeneousVectorBundle(apply(keys T, t -> weight(R,entries t)), values T, X);
	--if rank E' =!= binomial(r+n-1,n) then error "sto sbagliando nel calcolare il prodotto tensore di rappresentazioni";
	--if chern(1,E') =!=  binomial(r+n-1,n-1)*chern(1,E) then error "sto sbagliando nel calcolare la classe di chern";
	return E';
	)
