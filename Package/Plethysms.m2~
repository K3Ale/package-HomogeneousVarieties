	    );
	ListBundles = new HashTable from ListBundles;
	M := kunnethPartitions(n,m);
	M = new HashTable from (tally M);
	for g in keys M do (
	    for i from 1 to M#g do (
		S = S + ListBundles#g;
		);
	    );	
	return S;
	-*
